# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded automatically for local `serve`/`mock` runs via godotenv.

# --- Target ---
# mock: run against the local `mock` controller (default here; credentials below are
#       ignored and dummy values are used). live: hit a real UniFi controller.
MODE=mock
# Only needed if the mock runs on a non-default address (see `mock --addr`).
# MOCK_URL=http://localhost:8090

# --- UniFi controller (required when MODE=live; ignored when MODE=mock) ---
UNIFI_HOST=https://192.168.1.1
UNIFI_USERNAME=admin
UNIFI_PASSWORD=your-controller-password
UNIFI_SITE=default

# --- Presence ---
# Comma-separated hostnames to track (must match the client hostnames the
# controller reports). The mock lists phone1,phone2 by default.
TRACK_DEVICES=phone1,phone2
POLL_INTERVAL=10s
# Consecutive missed polls before a device flips to not_home (smooths blips).
FAILURE_THRESHOLD=5
POLL_MAX_RETRIES=3
READY_FAILURE_THRESHOLD=3

# --- MQTT ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=unifi-ha-presence-mqtt
MQTT_TOPIC_PREFIX=unifi
HA_DISCOVERY_PREFIX=homeassistant

# --- Health & logging ---
HEALTH_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
