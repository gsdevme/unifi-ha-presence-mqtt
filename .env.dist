# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Loaded automatically for local `serve`/`mock` runs via godotenv.

# --- Target ---
# mock: run against the local `mock` controller (default here; the API key below is
#       ignored and a dummy is used). live: hit a real UniFi console.
MODE=mock
# Only needed if the mock runs on a non-default address (see `mock --addr`).
# MOCK_URL=http://localhost:8090

# --- UniFi console (required when MODE=live; ignored when MODE=mock) ---
# Generate a local API key on the console: Settings -> Control Plane -> Integrations
# -> API Keys -> Create API Key (shown once). It is sent as the X-API-KEY header.
UNIFI_HOST=https://192.168.1.1
UNIFI_API_KEY=your-local-api-key
# Site name (resolved to its UUID at startup; falls back to the sole site).
UNIFI_SITE=default

# --- Presence ---
# Comma-separated devices to track, each "Name" or "Name=Pattern":
#   - Name is the Home Assistant identity (entity name + topic), your choice.
#   - Pattern (default = Name) is a case-insensitive SUBSTRING matched against the
#     client's name or MAC. The console appends a MAC suffix to names (e.g.
#     "iPhone-X fd:81"), so a plain name still matches; a full/partial MAC matches too.
#     For phones with rotating/private MACs, match on a stable name.
# Examples:  iPhone-X=e8:78:65:00:fd:81   or   iPhone-X   or   Phone=fd:81
# The mock lists phone1,phone2 by default.
TRACK_DEVICES=phone1,phone2
POLL_INTERVAL=10s
# Consecutive missed polls before a device flips to not_home (smooths blips).
FAILURE_THRESHOLD=5
POLL_MAX_RETRIES=3
READY_FAILURE_THRESHOLD=3

# --- MQTT ---
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=unifi-ha-presence-mqtt
MQTT_TOPIC_PREFIX=unifi
HA_DISCOVERY_PREFIX=homeassistant

# --- Health & logging ---
HEALTH_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=text
